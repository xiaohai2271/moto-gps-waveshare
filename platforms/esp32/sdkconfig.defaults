# Waveshare ESP32-S3-Touch-AMOLED-1.75C: 32 MB QIO flash and 8 MB octal PSRAM.
# These values match the official ESP-IDF example for this exact board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# The board port supplies its own PSRAM draw buffers and explicitly opts into
# direct PSRAM DMA. Keep a single outstanding QSPI transaction so old display
# frames cannot accumulate; the original BSP's default bounce buffers are not
# used by this board port.
CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH=1
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# LVGL timing and the official BSP worker both use millisecond-scale scheduling.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_DEF_REFR_PERIOD=25
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Creating the complete four-page LVGL instrument UI calls deeply into LVGL
# after the vendor BSP has initialized the display. The ESP-IDF default 3584
# byte app_main stack overflows during that one-time startup on real hardware.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# NimBLE is the phone transport. Bluetooth Classic is intentionally disabled
# on ESP32-S3 and not required by the navigation link.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
# 185 is the practical iOS ATT MTU and fits NimBLE's standard mbuf pools.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185

# Bluetooth + WiFi coexistence on the ESP32-S3.
#
# The WiFi and BT controllers share the internal SRAM pool, and the LCD reads
# its colour buffer straight out of PSRAM over the same octal bus the WiFi
# driver uses. Getting all three to run at once needs a deliberate split:
#
#   * NimBLE host allocations go to PSRAM, which frees the internal SRAM that
#     the WiFi driver needs for its mblock pools ("esf_buf_setup_static: alloc
#     eb fail" otherwise).
#   * The WiFi/LWIP pools stay in internal RAM, because putting them in PSRAM
#     starves the LCD's PSRAM DMA and the panel freezes with "spi_master: DMA
#     TX underflow detected".
#   * The WiFi receive/transmit pools are trimmed so the driver fits into the
#     internal RAM the display and BLE leave behind.
#   * The NimBLE buffer pools are trimmed as well; a single BLE connection
#     does not need the default headroom.
#
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP stays off on purpose: it is what puts
# the WiFi buffers on the PSRAM bus that the display needs.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=12
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=20
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_CSI_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# The WiFi driver runs on core 1 so it does not preempt the LVGL task and the
# display's SPI transfers on core 0.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
